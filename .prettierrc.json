{
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.md", "options": { "printWidth": 90, "proseWrap": "preserve" } },
    { "files": "*.css", "options": { "printWidth": 100 } }
  ]
}
